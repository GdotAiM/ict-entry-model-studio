# Copy to .env (git-ignored) and fill in. Never commit real values.
# Telegram: create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (any SMTP provider; for Gmail use an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional: restrict channels (telegram,email). Default = every configured channel.
NOTIFY_CHANNELS=

# Optional: scheduler runner (python | claude) and extra args for `claude -p`
WATCH_RUNNER=python
CLAUDE_ARGS=

# TradingView data backend: auto (TradingView-API via Node first, then tvDatafeed) | node | tvdatafeed
TV_BACKEND=auto
